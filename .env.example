# Optional: `docker compose up` works without this file, for trying the app on your own machine.
# Copy it to .env to change a value. Set your own password and key before running this anywhere else.

POSTGRES_PASSWORD=changeme
# openssl rand -base64 64
JWT_KEY=

# The address is http://localhost:APP_PORT
APP_PORT=8080

# Only needed for profile picture uploads. AWS_REGION is the bucket's region.
AWS_REGION=eu-central-1
AWS_BUCKET_NAME=
AWS_ACCESS_KEY=
AWS_SECRET_KEY=

# Creates a "demo" account with sample data on first start. Used for the live demo.
DEMO_PASSWORD=

# Only for docker-compose.prod.yml on the server (docs/deploy-vps.md).
DOMAIN=
IMAGE_PREFIX=
# Set by each deployment to the commit that is running.
IMAGE_TAG=
